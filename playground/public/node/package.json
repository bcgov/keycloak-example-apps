{
  "name": "sso-saml-playground",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npx tsc && cpx 'src/views/**' 'dist/views'",
    "start": "node dist/server.js",
    "copy-assets": "cp src/*.pem dist && cp -r src/views dist",
    "dev": " yarn run copy-assets && concurrently \"npx tsc --watch\" \"nodemon -q dist/server.js\"",
    "local": "nodemon src/server.ts"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cookie": "^0.5.0",
    "cookie-parser": "^1.4.6",
    "cpx": "^1.5.0",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.8",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "https": "^1.0.0",
    "passport": "^0.6.0",
    "passport-saml": "^3.2.4",
    "ts-node": "^10.9.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.6",
    "@types/node": "^18.14.6",
    "@types/passport": "^1.0.12",
    "concurrently": "^7.6.0",
    "nodemon": "^2.0.21",
    "typescript": "^4.9.5"
  },
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=18.0.0"
  }
}
